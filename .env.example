# Copy to `.env` and fill in. All values are optional for the offline MVP.

# Claude API — when unset, the pipeline uses the deterministic offline extractor
# so the whole system still runs (and tests pass) without a key.
ANTHROPIC_API_KEY=

# Model routing (Abschnitt 5.7). Defaults are sensible; override if needed.
MCI_MODEL_STRONG=claude-opus-4-8
MCI_MODEL_MEDIUM=claude-sonnet-5
MCI_MODEL_SMALL=claude-haiku-4-5-20251001

# Hard per-run cost cap in USD (Abschnitt 5.7). Pipeline aborts with a partial
# result instead of a silent cost explosion.
MCI_RUN_COST_CAP_USD=2.00

# SQLite database path.
MCI_DB_PATH=data/mci.db

# Confidence gate: below this the Strategist may only "observe" or "research".
MCI_CONFIDENCE_GATE=0.6
